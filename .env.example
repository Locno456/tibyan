# Tibyan MVP - Environment Variables
# انسخ هذا الملف إلى .env.local واملأ القيم

# ============================================
# Gemini Flash Lite - الخطة المجانية 100%
# ============================================
# احصل على مفتاح مجاني من: https://aistudio.google.com/app/apikey
# الخطة المجانية: 60 طلب/دقيقة - 1500 طلب/يوم - مجاناً تماماً
# النموذج الافتراضي: gemini-3.5-flash-lite (الأسرع والأرخص - ساري في أكتوبر 2026)
# ⚠️ نماذج 1.5 (ومنها gemini-1.5-flash-8b) أوقفتها Google في 2025-09-29 - لا تستخدمها
# المرجع: https://ai.google.dev/gemini-api/docs/models

GEMINI_API_KEY=AIzaSy..._YOUR_FREE_KEY_HERE

# اختياري - اختر النموذج (افتراضي: flashLite = gemini-3.5-flash-lite)
# القيم: flashLite (=3.5-flash-lite)، flash31Lite (=3.1-flash-lite)، flash (=3.8-flash)، أو اسم نموذج كامل
GEMINI_MODEL=flashLite

# تحقق أن النموذج يعمل فعلاً قبل العرض:
#   curl -s "localhost:3000/api/health?probe=1"
#   → verdict: working  = النموذج يستجيب
#   → verdict: broken   = المفتاح موجود لكن الاستدعاء يفشل (اقرأ liveProbe.error)
#   → verdict: offline  = لا مفتاح، الردود قوالب محلية ثابتة

# ============================================
# ملاحظات:
# ============================================
# - MVP يعمل 100% بدون أي مفتاح (Fallback محلي بقوالب بينات)
# - مع GEMINI_API_KEY: يستخدم Gemini Flash Lite للشرح البنفسجي فقط
# - النصوص الزرقاء (الشرعية) دائماً من JSON المحلي الموثق - لا توليد
# - حارس صفر اختلاق يمنع أي آية/حديث غير موجود حرفياً حتى لو Gemini حاول

# ============================================
# متغيرات إضافية (اختيارية للإنتاج الكامل)
# ============================================
# Qdrant - Vector DB (اختياري - يوجد fallback JSON)
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=...

# OpenAI - بديل (اختياري)
# OPENAI_API_KEY=sk-...

# Cohere - Reranker (اختياري)
# COHERE_API_KEY=...
