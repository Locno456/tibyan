# Tibyan MVP - Environment Variables
# انسخ هذا الملف إلى .env.local واملأ القيم

# ============================================
# Gemini Flash Lite - الخطة المجانية 100%
# ============================================
# احصل على مفتاح مجاني من: https://aistudio.google.com/app/apikey
# الخطة المجانية: 60 طلب/دقيقة - 1500 طلب/يوم - مجاناً تماماً
# النموذج المقترح: gemini-1.5-flash-8b (الأرخص والأسرع)
# أو: gemini-2.0-flash-lite (الجديد - أسرع)

GEMINI_API_KEY=AIzaSy..._YOUR_FREE_KEY_HERE

# اختياري - اختر النموذج (افتراضي: flashLite = gemini-1.5-flash-8b)
# القيم: flashLite, flash, flash2Lite, أو اسم نموذج كامل
GEMINI_MODEL=flashLite

# ============================================
# ملاحظات:
# ============================================
# - MVP يعمل 100% بدون أي مفتاح (Fallback محلي بقوالب بينات)
# - مع GEMINI_API_KEY: يستخدم Gemini Flash Lite للشرح البنفسجي فقط
# - النصوص الزرقاء (الشرعية) دائماً من JSON المحلي الموثق - لا توليد
# - حارس صفر اختلاق يمنع أي آية/حديث غير موجود حرفياً حتى لو Gemini حاول

# ============================================
# متغيرات إضافية (اختيارية للإنتاج الكامل)
# ============================================
# Qdrant - Vector DB (اختياري - يوجد fallback JSON)
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=...

# OpenAI - بديل (اختياري)
# OPENAI_API_KEY=sk-...

# Cohere - Reranker (اختياري)
# COHERE_API_KEY=...
