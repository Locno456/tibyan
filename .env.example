# انسخ هذا الملف إلى .env.local محلياً، أو أضف القيم إلى Environment Variables في Vercel.
# جميع مفاتيح المزودات تُقرأ على الخادم فقط، ولا تُرسل إلى المتصفح.

# حساب اختياري ومزامنة سحابية عبر Supabase.
# أنشئ مشروعاً، ثم طبّق supabase/schema.sql من SQL Editor.
# هذه القيم العامة مخصصة للمتصفح؛ لا تضع service_role key هنا أبداً.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# اختيار افتراضي اختياري. provider هو المعرّف الظاهر في /api/models
# (google, anthropic, openai, openrouter, groq, zai, mistral, deepseek).
# عند عدم ضبطه، يُختار افتراضياً نموذج من كتالوج أول مزود مهيأ.
# AI_DEFAULT_PROVIDER=google
# AI_DEFAULT_MODEL=<model-id-from-provider-catalog>

# رجوع آمن للوضع القديم عند مشكلة في اختيار المصادر/الويب/الإجابة غير المحققة.
# فعّل TIBYAN_AGENT_ENABLED=false على الخادم ثم أعد النشر؛ يعيد المصادر الافتراضية
# (محلي + MCP)، ويعطل بحث الويب والوضع المتقدم. غياب المتغير يبقي وضع الوكيل الحالي مفعّلاً.
# TIBYAN_AGENT_ENABLED=false

# واجهة API اختيارية من خادم إلى خادم؛ معطلة افتراضياً. لا تضع المفتاح في المتصفح.
TIBYAN_API_ENABLED=false
# TIBYAN_API_KEY=<generate-with-openssl-rand-hex-32>

# Google AI Studio / Gemini. يقبل الاسم القديم GIMINI_API_KEY أيضاً.
GEMINI_API_KEY=
# الافتراضي إذا أعاده كتالوج Google: gemini-flash-lite-latest؛ إن غاب يُختار نموذج Flash Lite متاح.
# GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Groq
GROQ_API_KEY=
# GROQ_MODEL=

# Z.ai (تُقبل الأسماء Z_AI_API_KEY و ZHIPUAI_API_KEY أيضاً)
ZAI_API_KEY=
# ZAI_MODEL=

# مزودات إضافية متوافقة مع المحادثة
MISTRAL_API_KEY=
# MISTRAL_MODEL=
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=

# مصادر MCP للقراءة. تُكتشف أدوات القراءة المتاحة وتُستبعد أدوات الكتابة/الآثار الجانبية.
# ISLAMIC_CONTENT_MCP_URL=https://mcp.islamiccontent.org/mcp
# TAFSIR_MCP_URL=https://mcp.tafsir.net/mcp
# لتعطيل المصدر التكميلي: TAFSIR_MCP_URL=off

# اختبر إعدادات النماذج:
#   GET /api/models
# اختبر اتصال توليد فعلياً (يستهلك طلباً قصيراً من المزود):
#   GET /api/health?probe=1
# افحص اكتشاف أدوات MCP فقط (initialize + tools/list، دون tools/call):
#   GET /api/health?mcp=1

# ملاحظات:
# - لا يُعرض أي مزود بلا مفتاح خادم.
# - نافذة السياق تُعرض فقط عندما يعيدها API المزود؛ لا تُقدّر يدوياً.
# - النصوص القرآنية الحرفية تأتي من data/quran_full.json، لا من توليد النموذج.
# - الأسئلة غير المدعومة محلياً بلا نموذج أو دليل كافٍ تنتهي بامتناع صريح.
